# ------------------------------------------------------------------
# Bellbird Books - environment configuration template
# Copy this file to ".env" and fill in real values for local dev.
# ".env" itself is ignored by git and must NEVER be committed.
# ------------------------------------------------------------------

FLASK_APP=app.py
FLASK_ENV=development
# Generate a real secret key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-local-env

# SQLite path used in development. In production this is overridden by
# the DATABASE_URL provided by the hosting vendor.
DATABASE_URL=sqlite:///instance/bellbird.sqlite3

# Set to "production" on the deployment host.
APP_ENV=development
